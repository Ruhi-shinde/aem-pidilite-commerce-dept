<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">embitel_customersuggestion_suggestion_listing.embitel_customersuggestion_suggestion_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>embitel_customersuggestion_suggestion_columns</spinner>
        <deps>
            <dep>embitel_customersuggestion_suggestion_listing.embitel_customersuggestion_suggestion_listing_data_source</dep>
        </deps>
        <!--<buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Suggestion</label>
            </button>
        </buttons>-->
    </settings>
    <dataSource name="embitel_customersuggestion_suggestion_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Embitel_CustomerSuggestion::customer_suggestion_view</aclResource>
        <dataProvider name="embitel_customersuggestion_suggestion_listing_data_source"
                      class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button">
            <settings>
                <options>
                    <option name="csv" xsi:type="array">
                        <item name="value" xsi:type="string">csv</item>
                        <item name="label" xsi:type="string" translate="true">CSV</item>
                    </option>
                    <option name="xml" xsi:type="array">
                        <item name="value" xsi:type="string">xml</item>
                        <item name="label" xsi:type="string" translate="true">Excel XML</item>
                    </option>
                </options>
            </settings>
        </exportButton>
        <filters name="listing_filters"/>
        <!--<massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected suggestions?</message>
                        <title translate="true">Delete Suggestions</title>
                    </confirm>
                    <url path="embitel_customersuggestion/suggestion/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>-->
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="embitel_customersuggestion_suggestion_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>text</filter>
                <sorting>asc</sorting>
                <label translate="true">Entity ID</label>
            </settings>
        </column>
        <column name="user_id" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">User ID</label>
            </settings>
        </column>
        <column name="user_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">User Name</label>
            </settings>
        </column>
        <column name="user_email" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">User Email</label>
            </settings>
        </column>
        <column name="suggestion" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Suggestion</label>
            </settings>
        </column>
        <column name="created_at" sortOrder="60">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <column name="updated_at" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Embitel\CustomerSuggestion\Ui\Component\Listing\Column\SuggestionActions" sortOrder="80">
            <settings>
                <indexField>entity_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>107</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
