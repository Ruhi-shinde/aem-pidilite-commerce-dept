<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="customer_suggestion" resource="default" engine="innodb" comment="Customer Suggestion Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="user_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="text" name="suggestion" nullable="false" comment="Suggestion"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="CUSTOMER_SUGGESTION_USER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="customer_suggestion" column="user_id" referenceTable="customer_entity"
                    referenceColumn="entity_id" onDelete="CASCADE"/>

        <index referenceId="CUSTOMER_SUGGESTION_USER_ID" indexType="btree">
            <column name="user_id"/>
        </index>
    </table>
</schema>
