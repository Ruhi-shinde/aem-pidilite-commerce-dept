<?xml version="1.0"?>

<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <fieldset name="custom_product_features" sortOrder="90">

        <settings>
            <label translate="true">Product Features</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <dataScope>data.product</dataScope>
        </settings>

        <dynamicRows name="custom_product_features">

            <settings>

                <componentType>dynamicRows</componentType>

                <addButtonLabel translate="true">
                    Add Feature
                </addButtonLabel>

                <deleteProperty>is_delete</deleteProperty>
                <deleteValue>true</deleteValue>

                <identificationProperty>id</identificationProperty>

                <dndConfig>
                    <param name="name" xsi:type="string">
                        ${ $.name }_dnd
                    </param>

                    <param name="component" xsi:type="string">
                        Magento_Ui/js/dynamic-rows/dnd
                    </param>

                    <param name="template" xsi:type="string">
                        ui/dynamic-rows/cells/dnd
                    </param>

                    <param name="recordsProvider" xsi:type="string">
                        ${ $.name }
                    </param>

                    <param name="enabled" xsi:type="boolean">
                        true
                    </param>
                </dndConfig>

            </settings>

            <container name="record"
                       component="Magento_Ui/js/dynamic-rows/record">

                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">

                        <item name="componentType"
                              xsi:type="string">
                            container
                        </item>

                        <item name="isTemplate"
                              xsi:type="boolean">
                            true
                        </item>

                        <item name="is_collection"
                              xsi:type="boolean">
                            true
                        </item>

                        <item name="positionProvider" xsi:type="string">sort_order</item>
                    </item>
                </argument>

                <field name="id"
                       formElement="input">

                    <settings>
                        <visible>false</visible>
                        <dataType>number</dataType>
                    </settings>

                </field>

                <field name="title"
                       formElement="input">

                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Title</label>

                        <validation>
                            <rule name="required-entry"
                                  xsi:type="boolean">
                                true
                            </rule>
                        </validation>

                    </settings>

                </field>

               <field name="file" formElement="fileUploader">

                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">File</label>

                        <elementTmpl>
                            ui/form/element/uploader/uploader
                        </elementTmpl>
                    </settings>

                    <formElements>
                        <fileUploader>
                            <settings>

                                <isMultipleFiles>false</isMultipleFiles>

                                <allowedExtensions>
                                    pdf doc docx xls xlsx ppt pptx txt csv jpg jpeg gif png webp mp4 mov webm avi mkv zip
                                </allowedExtensions>

                                <maxFileSize>10485760</maxFileSize>

                                <uploaderConfig>
                                    <param xsi:type="url"
                                        name="url"
                                        path="productfeatures/sample/upload"/>
                                </uploaderConfig>

                            </settings>
                        </fileUploader>
                    </formElements>

                </field>

                <field name="sort_order" formElement="input">
                    <settings>
                        <visible>false</visible>
                        <dataType>number</dataType>
                    </settings>
                </field>

                <actionDelete name="actionDelete">

                    <settings>
                        <componentType>actionDelete</componentType>
                        <label translate="true">Actions</label>
                    </settings>

                </actionDelete>

            </container>

        </dynamicRows>

    </fieldset>

</form>
