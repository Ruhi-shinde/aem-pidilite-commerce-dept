<?xml version="1.0" ?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="embitel_bookmark" resource="default" engine="innodb" comment="embitel_bookmark Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <column name="user_id" nullable="false" xsi:type="int" unsigned="true" comment="user_id" identity="false"/>
        <index referenceId="EMBITEL_BOOKMARK_USER_ID" indexType="btree">
            <column name="user_id"/>
        </index>

        <column name="bookmark_id" nullable="false" xsi:type="varchar" comment="bookmark_id" length="255"/>
        <index referenceId="EMBITEL_BOOKMARK_BOOKMARK_ID" indexType="btree">
            <column name="bookmark_id"/>
        </index>

        <column name="child_id" nullable="true" xsi:type="int" unsigned="true" comment="child_id" identity="false"/>
        <index referenceId="EMBITEL_BOOKMARK_CHILD_ID" indexType="btree">
            <column name="child_id"/>
        </index>

        <column name="content_type" nullable="false" xsi:type="varchar" comment="content_type" length="100"/>
        <index referenceId="EMBITEL_BOOKMARK_CONTENT_TYPE" indexType="btree">
            <column name="content_type"/>
        </index>

        <column name="content_name" nullable="false" xsi:type="varchar" comment="content_name" length="255"/>

        <column name="created_at" nullable="false" xsi:type="timestamp" default="CURRENT_TIMESTAMP" on_update="false" comment="created_at"/>
        <column name="updated_at" nullable="false" xsi:type="timestamp" default="CURRENT_TIMESTAMP" on_update="true" comment="updated_at"/>
    </table>
</schema>
