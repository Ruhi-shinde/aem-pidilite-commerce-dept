<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Embitel\Bookmark\Api\BookmarkRepositoryInterface"
                type="Embitel\Bookmark\Model\BookmarkRepository"/>

    <preference for="Embitel\Bookmark\Api\Data\BookmarkInterface"
                type="Embitel\Bookmark\Model\Bookmark"/>

    <preference for="Embitel\Bookmark\Api\Data\BookmarkSearchResultsInterface"
                type="Magento\Framework\Api\SearchResults"/>

    <type name="Embitel\Bookmark\Model\BookmarkRepository">
        <plugin name="embitel_bookmark_apply_store_code_from_header"
                type="Embitel\Bookmark\Plugin\ApplyStoreCodeFromHeader"
                sortOrder="10"/>
    </type>

    <type name="Embitel\Bookmark\Model\ResourceModel\Bookmark\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">embitel_bookmark</argument>
            <argument name="resourceModel" xsi:type="string">
                Embitel\Bookmark\Model\ResourceModel\Bookmark
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="embitel_bookmark_bookmark_listing_data_source" xsi:type="string">
                    Embitel\Bookmark\Model\ResourceModel\Bookmark\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

</config>
