		<column name="parent_phone" nullable="false" xsi:type="varchar" comment="parent_phone" length="50"/>
		<column name="project_title" nullable="false" xsi:type="varchar" comment="project_title" length="255"/>
		<column name="video_url" nullable="true" xsi:type="text" comment="video_url"/>
		<column name="craft_image" nullable="true" xsi:type="text" comment="craft_image"/>
		<column name="project_description" nullable="false" xsi:type="text" comment="project_description"/>
		<column name="i_accept" nullable="false" xsi:type="smallint" default="0" comment="i_accept"/>
		<column name="created_at" nullable="false" xsi:type="timestamp" default="CURRENT_TIMESTAMP" on_update="false" comment="created_at"/>
		<column name="updated_at" nullable="false" xsi:type="timestamp" default="CURRENT_TIMESTAMP" on_update="true" comment="updated_at"/>
	</table>
