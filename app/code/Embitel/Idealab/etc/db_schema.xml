			<column name="idealab_id"/>
		</constraint>
		<column name="user_id" nullable="false" xsi:type="int" unsigned="true" comment="user_id" identity="false"/>
		<index referenceId="EMBITEL_IDEALAB_IDEALAB_USER_ID" indexType="btree">
			<column name="user_id"/>
		</index>
		<column name="student_first_name" nullable="false" xsi:type="varchar" comment="student_first_name" length="255"/>
		<column name="student_last_name" nullable="false" xsi:type="varchar" comment="student_last_name" length="255"/>
		<column name="student_date_of_birth" nullable="false" xsi:type="date" comment="student_date_of_birth"/>
