<?xml version="1.0" ?>

<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                embitel_idealab_idealab_form.idealab_form_data_source
            </item>
        </item>

        <item name="label" xsi:type="string" translate="true">
            General Information
        </item>

        <item name="template" xsi:type="string">
            templates/form/collapsible
        </item>
    </argument>

    <settings>

        <buttons>
            <button name="back"
                    class="Embitel\Idealab\Block\Adminhtml\Idealab\Edit\BackButton"/>

            <!--<button name="delete"
                    class="Embitel\Idealab\Block\Adminhtml\Idealab\Edit\DeleteButton"/>

            <button name="save"
                    class="Embitel\Idealab\Block\Adminhtml\Idealab\Edit\SaveButton"/>

            <button name="save_and_continue"
                    class="Embitel\Idealab\Block\Adminhtml\Idealab\Edit\SaveAndContinueButton"/>-->
        </buttons>

        <namespace>embitel_idealab_idealab_form</namespace>

        <dataScope>data</dataScope>

        <deps>
            <dep>
                embitel_idealab_idealab_form.idealab_form_data_source
            </dep>
        </deps>

    </settings>

    <dataSource name="idealab_form_data_source">

        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">
                    Magento_Ui/js/form/provider
                </item>
            </item>
        </argument>

        <settings>
            <submitUrl path="*/*/save"/>
        </settings>

        <dataProvider
            name="idealab_form_data_source"
            class="Embitel\Idealab\Model\Idealab\DataProvider">

            <settings>
                <requestFieldName>idealab_id</requestFieldName>
                <primaryFieldName>idealab_id</primaryFieldName>
            </settings>

        </dataProvider>

    </dataSource>

    <fieldset name="general">

        <settings>
            <label translate="true">General</label>
        </settings>

        <field name="user_id" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">User ID</label>
                <dataScope>user_id</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="user_name" formElement="input" sortOrder="15">
            <settings>
                <dataType>text</dataType>
                <label translate="true">User Name</label>
                <dataScope>user_name</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="user_email" formElement="input" sortOrder="18">
            <settings>
                <dataType>text</dataType>
                <label translate="true">User Email</label>
                <dataScope>user_email</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="student_first_name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Student First Name</label>
                <dataScope>student_first_name</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="student_last_name" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Student Last Name</label>
                <dataScope>student_last_name</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="student_date_of_birth" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Student Date of Birth</label>
                <dataScope>student_date_of_birth</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="student_school_name" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Student School Name</label>
                <dataScope>student_school_name</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="gender" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Gender</label>
                <dataScope>gender</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="grade_group" formElement="input" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Grade Group</label>
                <dataScope>grade_group</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="parent_email" formElement="input" sortOrder="80">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Parent Email</label>
                <dataScope>parent_email</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="parent_phone" formElement="input" sortOrder="90">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Parent Phone</label>
                <dataScope>parent_phone</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="project_title" formElement="input" sortOrder="100">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Project Title</label>
                <dataScope>project_title</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="video_url" formElement="input" sortOrder="110">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Video URL</label>
                <dataScope>video_url</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="craft_image" formElement="textarea" sortOrder="120">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Craft Image</label>
                <dataScope>craft_image</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="project_description" formElement="textarea" sortOrder="130">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Project Description</label>
                <dataScope>project_description</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="i_accept" formElement="select" sortOrder="140">
            <settings>
                <dataType>select</dataType>
                <label translate="true">I Accept</label>
                <dataScope>i_accept</dataScope>
                <disabled>true</disabled>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Embitel\Idealab\Model\Source\TrueFalse"/>
                    </settings>
                </select>
            </formElements>
        </field>

    </fieldset>

</form>