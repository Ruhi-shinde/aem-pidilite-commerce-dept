<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">embitel_contactus_contact_form.contactus_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Contact Request</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Embitel\ContactUs\Block\Adminhtml\Contact\Edit\BackButton"/>
        </buttons>
        <namespace>embitel_contactus_contact_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>embitel_contactus_contact_form.contactus_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="contactus_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="contactus_form_data_source"
                      class="Embitel\ContactUs\Model\ContactUs\DataProvider">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="entity_id" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Entity ID</label>
                <dataScope>entity_id</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="first_name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">First Name</label>
                <dataScope>first_name</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="last_name" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Last Name</label>
                <dataScope>last_name</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="city" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">City</label>
                <dataScope>city</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="email_id" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Email ID</label>
                <dataScope>email_id</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="mobile_number" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Mobile Number</label>
                <dataScope>mobile_number</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="message" formElement="textarea" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Message</label>
                <dataScope>message</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="created_at" formElement="input" sortOrder="80">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Created At</label>
                <dataScope>created_at</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="updated_at" formElement="input" sortOrder="90">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Updated At</label>
                <dataScope>updated_at</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
</form>
