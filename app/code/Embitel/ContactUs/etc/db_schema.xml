<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="embitel_contact_us" resource="default" engine="innodb" comment="Embitel Contact Us Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="first_name" nullable="false" length="255" comment="First Name"/>
        <column xsi:type="varchar" name="last_name" nullable="false" length="255" comment="Last Name"/>
        <column xsi:type="varchar" name="city" nullable="false" length="255" comment="City"/>
        <column xsi:type="varchar" name="email_id" nullable="true" length="255" comment="Email ID"/>
        <column xsi:type="varchar" name="mobile_number" nullable="false" length="20" comment="Mobile Number"/>
        <column xsi:type="text" name="message" nullable="false" comment="Message"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <index referenceId="EMBITEL_CONTACT_US_MOBILE_NUMBER" indexType="btree">
            <column name="mobile_number"/>
        </index>
        <index referenceId="EMBITEL_CONTACT_US_EMAIL_ID" indexType="btree">
            <column name="email_id"/>
        </index>
    </table>
</schema>
