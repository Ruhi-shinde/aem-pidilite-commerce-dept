<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">vse_category_form.vse_category_form_data_source</item>
            <item name="component" xsi:type="string">Magento_Ui/js/form/form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        
    </argument>

    <settings>
        <spinner>general</spinner>
        <namespace>vse_category_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>vse_category_form.vse_category_form_data_source</dep>
        </deps>
        <buttons>
            <button name="back" class="Embitel\CategoryManager\Block\Adminhtml\Category\Edit\Button\Back"/>
            <button name="delete" class="Embitel\CategoryManager\Block\Adminhtml\Category\Edit\Button\Delete"/>
            <button name="save" class="Embitel\CategoryManager\Block\Adminhtml\Category\Edit\Button\Save"/>
        </buttons>
    </settings>

    <dataSource name="vse_category_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="vse_category/category/save"/>
        </settings>
        <dataProvider class="Embitel\CategoryManager\Model\Category\FormDataProvider"
                    name="vse_category_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Solution Information</label>
        </settings>

        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>

        <!-- Solution Title -->
        <field name="name" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Solution Title</label>
                <dataScope>name</dataScope>
            </settings>
        </field>

       <field name="parent_id" component="Magento_Catalog/js/components/new-category" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="showCheckbox" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Select Parent Solution</label>
                <dataScope>parent_id</dataScope>
                <elementTmpl>ui/grid/filters/elements/ui-select</elementTmpl>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Embitel\CategoryManager\Model\Category\Source\ParentCategoryOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>

        

        <!-- Image Upload Field -->
        <field name="image" formElement="imageUploader">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/image</item>
                </item>
            </argument>
            <settings>
                <dataType>string</dataType>
                <label translate="true">Image</label>
                <visible>true</visible>
                <required>false</required>
                <dataScope>image</dataScope>
                <notice translate="true">Only jpg, jpeg, png and gif image type supported.</notice>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="vse_category/category_image/upload"/>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                    </settings>
                </imageUploader>
            </formElements>
        </field>

        <!-- Category Banner Upload Field -->
        <field name="category_banner" formElement="imageUploader">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/image</item>
                </item>
            </argument>
            <settings>
                <dataType>string</dataType>
                <label translate="true">Banner Image</label>
                <visible>true</visible>
                <required>false</required>
                <dataScope>category_banner</dataScope>
                <notice translate="true">Only jpg, jpeg, png and gif image type supported.</notice>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="vse_category/category_image/upload"/>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                    </settings>
                </imageUploader>
            </formElements>
        </field>

        <!-- Enable Solution Switch -->
        <field name="is_active" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enable Solution</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <!-- Is Standard Solution? Switch -->
        <field name="is_standard" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Is Standard Solution?</label>
                <dataScope>is_standard</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>

        <!-- Rich Text Editor Field -->
       <field name="description" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="type" xsi:type="string">textarea</item>
                    <item name="source" xsi:type="string">description</item>
                    <item name="wysiwyg" xsi:type="boolean">true</item>
                    <item name="is_page_builder_enabled" xsi:type="boolean">false</item>
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="add_images" xsi:type="boolean">true</item>
                        <item name="files_browser_window_url" xsi:type="string">cms/wysiwyg_images/index/</item>
                        <item name="enabled" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <settings>
                <label translate="true">Solution Description</label>
                <dataScope>description</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <rows>8</rows>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
    </fieldset>
</form>