<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="customer_child" resource="default" engine="innodb" comment="Customer Children">
        <column xsi:type="int" name="child_id" unsigned="true" nullable="false" identity="true"
                comment="OTP ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="date_of_birth" nullable="false" length="255" comment="DOB"/>
        <column xsi:type="varchar" name="school" nullable="false" length="255" comment="School"/>
        <column xsi:type="timestamp" name="creation_time" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Creation Time"/>
        <column xsi:type="timestamp" name="update_time" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Modification Time"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="child_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="CUTOMER_CHILD_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="customer_child"
                    column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>

    </table>
</schema>

