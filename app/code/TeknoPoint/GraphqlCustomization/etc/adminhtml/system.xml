<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="teknopoint" translate="label" sortOrder="10">
            <label>TeknoPoint</label>
        </tab>
        <section id="teknopoint_config" translate="label" sortOrder="130" showInDefault="1" showInWebsite="1"
                 showInStore="1">
            <class>separator-top</class>
            <label>Graphql Customization Configurations</label>
            <tab>teknopoint</tab>
            <resource>TeknoPoint_GraphqlCustomization::setting</resource>
            <group id="gql_customization_configuration" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Graphql Attribution Configuration</label>
                <field id="custom_attribute" translate="label" type="text" sortOrder="1" showInDefault="1"
                       showInWebsite="0" showInStore="0">
                    <label>Custom Attributes Code</label>
                    <comment>Please Provide custom attribute codes in comma separated which you have created</comment>
                </field>
            </group>
        </section>
    </system>
</config>
